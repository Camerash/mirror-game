; Mirror prototype. Engine: Godot 4.7.2 stable.
config_version=5

[application]
config/name="Mirror"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A small world, a different way through."
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.92, 0.90, 0.85, 1)

[display]
window/size/viewport_width=1152
window/size/viewport_height=800
window/size/window_width_override=1152
window/size/window_height_override=800
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.92, 0.90, 0.85, 1)

[physics]
3d/default_gravity=9.8

[debug]
gdscript/warnings/untyped_declaration=1
